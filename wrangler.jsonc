{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app6",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fea2dbef-5443-4caf-9f7b-d2c5b8a3a6c5","database_name": "web-app7" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5d7dfcc6c3874811a83a71ce6fa1c354" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
